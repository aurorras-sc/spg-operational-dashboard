table 'Dim Workflow'
	lineageTag: 6e4c1c19-9e94-43d3-8ba0-c037604061c2

	column Workflow
		dataType: string
		isKey
		lineageTag: 1d31613e-b732-4942-bc34-fdd29bc77fc6
		summarizeBy: none
		sourceColumn: Workflow

		annotation SummarizationSetBy = User

	partition 'Dim Workflow' = m
		mode: import
		source =
				let
				    A = Table.SelectColumns(OpenTasks, {"Workflow"}),
				    B = Table.SelectColumns(Completed, {"Workflow"}),
				    U = Table.Distinct(Table.Combine({A, B})),
				    NoNull = Table.SelectRows(U, each [Workflow] <> null),
				    Sorted = Table.Sort(NoNull, {{"Workflow", Order.Ascending}})
				in
				    Sorted

	annotation PBI_ResultType = Table
