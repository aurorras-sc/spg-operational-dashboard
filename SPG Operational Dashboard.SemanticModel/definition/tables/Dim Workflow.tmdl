table 'Dim Workflow'
	lineageTag: 03e4bfae-8589-4dbf-a48b-baff77c96d9d

	column Workflow
		dataType: string
		isKey
		lineageTag: 9b54c78a-4283-4fdd-9a06-055afb18c5b0
		summarizeBy: none
		sourceColumn: Workflow

		annotation SummarizationSetBy = User

	partition 'Dim Workflow' = m
		mode: import
		source =
				let
				    A = Table.SelectColumns(OpenTasks, {"Workflow"}),
				    B = Table.SelectColumns(Completed, {"Workflow"}),
				    U = Table.Distinct(Table.Combine({A, B})),
				    NoNull = Table.SelectRows(U, each [Workflow] <> null),
				    Sorted = Table.Sort(NoNull, {{"Workflow", Order.Ascending}})
				in
				    Sorted

	annotation PBI_ResultType = Table
