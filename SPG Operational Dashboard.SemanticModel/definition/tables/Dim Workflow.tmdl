table 'Dim Workflow'
	lineageTag: 67f89220-ed8a-43a5-9462-af095504da90

	column Workflow
		dataType: string
		isKey
		lineageTag: 2cf32839-d17e-4aa7-8818-e0a1e97146b3
		summarizeBy: none
		sourceColumn: Workflow

		annotation SummarizationSetBy = User

	partition 'Dim Workflow' = m
		mode: import
		source =
				let
				    A = Table.SelectColumns(OpenTasks, {"Workflow"}),
				    B = Table.SelectColumns(Completed, {"Workflow"}),
				    U = Table.Distinct(Table.Combine({A, B})),
				    NoNull = Table.SelectRows(U, each [Workflow] <> null),
				    Sorted = Table.Sort(NoNull, {{"Workflow", Order.Ascending}})
				in
				    Sorted

	annotation PBI_ResultType = Table
