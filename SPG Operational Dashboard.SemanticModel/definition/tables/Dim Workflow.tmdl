table 'Dim Workflow'
	lineageTag: f54dfb02-5e5b-4dad-853b-ece56fc89591

	column Workflow
		dataType: string
		isKey
		lineageTag: e76cfbea-559e-4f04-acee-0564f795517a
		summarizeBy: none
		sourceColumn: Workflow

		annotation SummarizationSetBy = User

	partition 'Dim Workflow' = m
		mode: import
		source =
				let
				    A = Table.SelectColumns(OpenTasks, {"Workflow"}),
				    B = Table.SelectColumns(Completed, {"Workflow"}),
				    U = Table.Distinct(Table.Combine({A, B})),
				    NoNull = Table.SelectRows(U, each [Workflow] <> null),
				    Sorted = Table.Sort(NoNull, {{"Workflow", Order.Ascending}})
				in
				    Sorted

	annotation PBI_ResultType = Table
