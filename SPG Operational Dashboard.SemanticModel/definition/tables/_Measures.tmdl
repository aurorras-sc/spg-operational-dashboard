table '_Measures'
	lineageTag: bf29e5cc-428f-424d-bdf8-1e71554cfbe3

	/// Every open task row, including work scheduled ahead.
	measure 'Open items (all)' = COUNTROWS ( OpenTasks )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 02861ad8-b55a-4ecd-844d-6f6c978b48f2

	/// Open tasks available to be worked now (scheduled-ahead work excluded).
	measure 'Work on hand' = CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Scheduled] = FALSE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: bdbe26e4-419a-42fc-9b2d-49e058acca28

	measure 'Scheduled (not yet available)' = CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Scheduled] = TRUE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: b3d8e39c-971e-4f62-8e60-e7968b4e26af

	measure 'Files on hand' = CALCULATE ( DISTINCTCOUNT ( OpenTasks[File number] ), OpenTasks[Scheduled] = FALSE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 837a1b6b-9f67-4923-996d-5e69185df4fe

	/// Work on hand older than its step service level.
	measure 'Out of service' = CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Out of service] = TRUE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 16e56111-e86c-4a5b-8a2b-91754702d96e

	measure 'Within service' = [Work on hand] - [Out of service]
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 8baab594-583b-4b51-b833-b02d39df8b9b

	measure 'Out of service %' = DIVIDE ( [Out of service], [Work on hand] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Work on hand
		lineageTag: 2f3174d5-8329-4f79-88c3-ae92eaf6c5f2

	measure 'Oldest item (days)' = CALCULATE ( MAX ( OpenTasks[Age (days)] ), OpenTasks[Scheduled] = FALSE () )
		formatString: 0
		displayFolder: Work on hand
		lineageTag: dab51bb0-4434-445c-9530-7672c2c04c43

	measure 'Median age (days)' = CALCULATE ( MEDIAN ( OpenTasks[Age (days)] ), OpenTasks[Scheduled] = FALSE () )
		formatString: 0.0
		displayFolder: Work on hand
		lineageTag: d3608c75-8838-4d25-8f88-24b5f181709f

	measure 'Over 30 days' = CALCULATE ( [Work on hand], OpenTasks[Over 30 days] = TRUE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 58181800-c262-4c35-a094-1c5d7437de1f

	measure 'Over 90 days' = CALCULATE ( [Work on hand], OpenTasks[Over 90 days] = TRUE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: fb87cdb3-3676-42e5-a079-ff35a982b35f

	measure 'Over 90 days %' = DIVIDE ( [Over 90 days], [Work on hand] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Work on hand
		lineageTag: 4914829f-feb7-4282-adfc-082441f30d29

	measure 'Share of work on hand' = DIVIDE ( [Work on hand], CALCULATE ( [Work on hand], REMOVEFILTERS ( 'Dim Aging Band' ), REMOVEFILTERS ( OpenTasks[Aging band] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Work on hand
		lineageTag: 30c713d4-192b-45bf-8792-31e8871dab66

	measure 'Received yesterday' = CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Received yesterday] = TRUE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: e52ed970-33f1-40e3-a65b-b706aff57a24

	measure 'Service status' = SWITCH ( TRUE (), ISBLANK ( [Out of service %] ), BLANK (), [Out of service %] <= MAX ( Thresholds[Green max] ), "Green", [Out of service %] <= MAX ( Thresholds[Amber max] ), "Amber", "Red" )
		displayFolder: Status
		lineageTag: 6319d303-8ba6-4093-8888-49d0b9b54d02

	measure 'Service status colour' = SWITCH ( [Service status], "Green", "#3EBD5E", "Amber", "#F3B921", "Red", "#D02D4F", "#8A949C" )
		displayFolder: Status
		lineageTag: ed18027c-9489-4429-b874-5925a22d110f

	measure 'Service status icon' = SWITCH ( [Service status], "Green", UNICHAR ( 9679 ) & " Green", "Amber", UNICHAR ( 9679 ) & " Amber", "Red", UNICHAR ( 9679 ) & " Red", BLANK () )
		displayFolder: Status
		lineageTag: e122e3d2-86ea-491d-a244-871c91e1bab7

	measure 'Work on hand subtitle' = FORMAT ( [Files on hand], "#,0" ) & " files  |  oldest " & FORMAT ( [Oldest item (days)], "0" ) & " d  |  " & FORMAT ( [Over 30 days], "#,0" ) & " over 30 d"
		displayFolder: Status
		lineageTag: ec1d3c02-baf9-4269-b047-a04accd2c9ee

	measure 'Out of service subtitle' = FORMAT ( [Out of service], "#,0" ) & " of " & FORMAT ( [Work on hand], "#,0" ) & " available items past service level"
		displayFolder: Status
		lineageTag: a3defc5b-6c30-42f3-b748-4a381818e0a9

	measure 'Unassigned items' = CALCULATE ( [Work on hand], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: 0cae98bf-320c-4cb3-879f-23d244ab6ec6

	measure 'Unassigned files' = CALCULATE ( [Files on hand], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: 66646741-b14a-4ec7-a638-c3310566560e

	measure 'Unassigned over 30 days' = CALCULATE ( [Over 30 days], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: 30a23f91-af3b-46ad-b712-918dacd41204

	measure 'Unassigned out of service' = CALCULATE ( [Out of service], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: 11959896-5437-4941-9000-89adfb485c28

	measure 'Unassigned out of service %' = DIVIDE ( [Unassigned out of service], [Unassigned items] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Unassigned
		lineageTag: 4bb203e9-90ce-4548-a595-cf9acf480f24

	measure 'Unassigned oldest (days)' = CALCULATE ( [Oldest item (days)], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () )
		formatString: 0
		displayFolder: Unassigned
		lineageTag: 579c7760-6e7b-4137-ae36-d08659ea165a

	measure 'Renewals in pipeline' = CALCULATE ( [Work on hand], OpenTasks[In renewal pipeline] = TRUE () )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: 354a6e78-ece0-45de-a9b2-b032b3e8b8ba

	measure 'Share of renewals' = DIVIDE ( [Renewals in pipeline], CALCULATE ( [Renewals in pipeline], REMOVEFILTERS ( OpenTasks[Renewal stage] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Renewal pipeline
		lineageTag: e06d4a1c-7d3a-4c7e-af65-989559e00a38

	measure 'Not yet quoted' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Not yet quoted" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: 7bfb31da-d4f3-4b14-bea2-56a686196ce4

	measure 'Quoted - with agent' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Quoted - with agent" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: abef1e56-0017-485d-baae-beb3f7c2dfc0

	measure 'Bound - awaiting issue' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Bound - awaiting issue" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: 1edc943c-4742-4fc1-8feb-2dd974bbd6d2

	measure 'Not renewing' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Not renewing" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: 29c1ac3c-c79a-4f01-a35b-71cd6164a243

	measure 'Not quoted %' = DIVIDE ( [Not yet quoted], [Renewals in pipeline] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Renewal pipeline
		lineageTag: 50fe8f03-56ef-400c-827b-07f211731b62

	measure 'Renewal stage subtitle' = FORMAT ( [Share of renewals], "0%" ) & " of renewals  |  " & FORMAT ( [Out of service], "#,0" ) & " out of service  |  oldest " & FORMAT ( [Oldest item (days)], "0" ) & " d"
		displayFolder: Renewal pipeline
		lineageTag: 98a57e4c-a626-413d-a185-2ba2c56b0a96

	/// Release/Kill actions on the day before the snapshot. Release = completed.
	measure 'Completed yesterday' = COUNTROWS ( Completed )
		formatString: #,0
		displayFolder: Completed
		lineageTag: c9997c30-c6e5-40f6-93c5-3e940ecfd0dd

	measure 'Met SLA on completion' = CALCULATE ( COUNTROWS ( Completed ), Completed[Met SLA] = TRUE () )
		formatString: #,0
		displayFolder: Completed
		lineageTag: d9d789fc-e019-474d-af88-de20645088ec

	measure 'Within SLA on completion %' = DIVIDE ( [Met SLA on completion], [Completed yesterday] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Completed
		lineageTag: 6639b12a-ad2f-4058-abe5-e5d6eed44e15

	measure 'Median turnaround (days)' = MEDIAN ( Completed[Turnaround (days)] )
		formatString: 0.0
		displayFolder: Completed
		lineageTag: a067cc14-bb10-48db-87cc-31e298b09108

	measure 'Average turnaround (days)' = AVERAGE ( Completed[Turnaround (days)] )
		formatString: 0.0
		displayFolder: Completed
		lineageTag: 32e6e049-951a-4f3e-b677-94ca3e9e803f

	measure 'Median hours in step' = MEDIAN ( Completed[Hours in step] )
		formatString: 0.0
		displayFolder: Completed
		lineageTag: e6469534-14e7-4877-a90e-572f2d302e46

	measure 'Median time in step' = VAR h = [Median hours in step] RETURN IF ( ISBLANK ( h ), BLANK (), IF ( h < 24, FORMAT ( h, "0.0" ) & " h", FORMAT ( h / 24, "0.0" ) & " d" ) )
		displayFolder: Completed
		lineageTag: 119e7398-7e98-4fe2-a401-e4bc378392a2

	measure 'Rework released' = CALCULATE ( COUNTROWS ( Completed ), Completed[Is rework] = TRUE () )
		formatString: #,0
		displayFolder: Completed
		lineageTag: 560f1798-2395-4b2a-96b4-42e1479fc106

	measure 'Production released' = [Completed yesterday] - [Rework released]
		formatString: #,0
		displayFolder: Completed
		lineageTag: fdc7d28d-2a07-4202-9b8d-a43ae9cbabfe

	measure 'Rework rate' = DIVIDE ( [Rework released], [Completed yesterday] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Completed
		lineageTag: cdeee88b-f545-49ef-99d0-b358a57e6fe2

	measure 'Within hour target' = SUMX ( Completed, IF ( Completed[Hours in step] <= RELATED ( 'Dim Step'[Hour target] ), 1, 0 ) )
		formatString: #,0
		displayFolder: Completed
		lineageTag: d3c404be-78e7-4a75-a0fa-64d59060dff3

	measure 'Within hour target %' = DIVIDE ( [Within hour target], [Completed yesterday] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Completed
		lineageTag: 6104c43d-c134-4dda-8259-4158c2e9c49e

	measure 'Open filings' = COUNTROWS ( Compliance )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 0baeb5a3-2825-402e-9849-0fba67273498

	measure 'Past due' = CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "past" )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: c06e1bde-0d1d-4ca2-bb54-028c8612a1bd

	measure 'Past due - fining states' = CALCULATE ( [Past due], Compliance[Fining state] = TRUE () )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: c6c86fb6-a5f2-428c-bb43-f44f74aec42d

	measure 'Past due and over 30 days (stuck)' = CALCULATE ( [Past due], Compliance[Over 30 days] = TRUE () )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 7acc492d-39d8-4113-b758-7464ef8e6ab3

	measure 'Due within 14 days' = CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "red" )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 2f5e6a4a-b0a6-4563-8f5f-2fe83be1076b

	measure 'Due in 15-30 days' = CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "amber" )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 5a4996ec-f655-4085-a68f-e25174bb6433

	measure 'On track' = CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "green" )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: b31cb1d3-4e86-45db-86da-9e57a1dabf6e

	measure 'Filings over 30 days old' = CALCULATE ( COUNTROWS ( Compliance ), Compliance[Over 30 days] = TRUE () )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: ee221932-6631-4ed2-85be-b8ff4de50585

	measure 'Oldest past due (days)' = CALCULATE ( MAX ( Compliance[Days past due] ), Compliance[Due band code] = "past" )
		formatString: +0;-0;0
		displayFolder: Compliance
		lineageTag: c6566ead-2802-485b-94d9-9cf118566b60

	measure 'Compliance status' = IF ( [Past due] > 0, "Past due", IF ( [Due within 14 days] > 0, "Due within 14 days", "On track" ) )
		displayFolder: Compliance
		lineageTag: b5e1f3d3-e9fa-447e-ab4d-4a2ec47125a7

	measure 'Fining state flag' = IF ( CALCULATE ( COUNTROWS ( Compliance ), Compliance[Fining state] = TRUE () ) > 0, "FINES", "" )
		displayFolder: Compliance
		lineageTag: de594fe3-4ee9-4a17-9536-c57dbf9612c3

	column 'Measure key'
		dataType: int64
		isHidden
		lineageTag: 0892a812-d81e-4343-b803-04b710d680e0
		summarizeBy: none
		sourceColumn: Measure key

		annotation SummarizationSetBy = User

	partition '_Measures' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Measure key" = Int64.Type], {{1}})
				in
				    Source

	annotation PBI_ResultType = Table
