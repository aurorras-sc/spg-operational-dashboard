table '_Measures'
	lineageTag: e8aee346-ac89-4d6f-a3ea-a177f2b5ee26

	/// Every open task row, including work scheduled ahead.
	measure 'Open items (all)' = COUNTROWS ( OpenTasks )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 2fa57440-4f97-40b7-ac77-45edea592356

	/// Open tasks available to be worked now (scheduled-ahead work excluded).
	measure 'Work on hand' = CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Scheduled] = FALSE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: b6977d9d-51aa-4c32-8b8c-8c010f68912d

	measure 'Scheduled (not yet available)' = COALESCE ( CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Scheduled] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: a97d1a9b-0eaa-4cbf-a9fe-c4e54810302d

	measure 'Files on hand' = CALCULATE ( DISTINCTCOUNT ( OpenTasks[File number] ), OpenTasks[Scheduled] = FALSE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 52a7bd09-b7e3-4f84-8f1e-c4d004baf4cf

	/// Work on hand older than its step service level.
	measure 'Out of service' = CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Out of service] = TRUE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: c9916cc6-f299-4274-bc68-6dea23888971

	measure 'Within service' = [Work on hand] - [Out of service]
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 998af5d9-156c-4996-bb24-1d8f1dc6c805

	measure 'Out of service %' = DIVIDE ( [Out of service], [Work on hand] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Work on hand
		lineageTag: 8d14b0f5-98ae-4f6f-9754-1f481179fe16

	measure 'Oldest item (days)' = CALCULATE ( MAX ( OpenTasks[Age (days)] ), OpenTasks[Scheduled] = FALSE () )
		formatString: 0
		displayFolder: Work on hand
		lineageTag: 39844a2f-8abd-4b36-ac6f-c13ade1f227b

	measure 'Median age (days)' = CALCULATE ( MEDIAN ( OpenTasks[Age (days)] ), OpenTasks[Scheduled] = FALSE () )
		formatString: 0.0
		displayFolder: Work on hand
		lineageTag: 118762f1-06ab-4154-bff1-6a23f5d85bf9

	measure 'Over 30 days' = CALCULATE ( [Work on hand], OpenTasks[Over 30 days] = TRUE () )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: a15f7797-7b4d-4fd7-a8e4-156436647c4b

	measure 'Over 90 days' = COALESCE ( CALCULATE ( [Work on hand], OpenTasks[Over 90 days] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 10f3ad88-f403-4123-a74f-4f8914e287f2

	measure 'Over 90 days %' = DIVIDE ( [Over 90 days], [Work on hand] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Work on hand
		lineageTag: 2cbcf173-ca35-4161-938f-3c0087cf42d5

	measure 'On hand 0-7' = CALCULATE ( [Work on hand], 'Dim Aging Band'[Aging band] = "0-7" )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: c032e595-4571-450c-9d83-edfb55f6f65b

	measure 'On hand 8-15' = CALCULATE ( [Work on hand], 'Dim Aging Band'[Aging band] = "8-15" )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 2f0c7a5f-aa8c-4e56-b72b-02b4bfd68ed8

	measure 'On hand 16-30' = CALCULATE ( [Work on hand], 'Dim Aging Band'[Aging band] = "16-30" )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: f09c9bf9-186e-4c41-94bc-5929eed0154f

	measure 'On hand 31-60' = CALCULATE ( [Work on hand], 'Dim Aging Band'[Aging band] = "31-60" )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 3b2db1e3-3bc0-4ee5-820c-dc903e58afb7

	measure 'On hand 61-90' = CALCULATE ( [Work on hand], 'Dim Aging Band'[Aging band] = "61-90" )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 705d3c22-94d5-4125-bdcb-1dfe2f2d81f4

	measure 'On hand 90+' = CALCULATE ( [Work on hand], 'Dim Aging Band'[Aging band] = "90+" )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: 5b877ab0-ecb6-4f53-9833-fb33d2f37db0

	measure 'Share of work on hand' = DIVIDE ( [Work on hand], CALCULATE ( [Work on hand], REMOVEFILTERS ( 'Dim Aging Band' ), REMOVEFILTERS ( OpenTasks[Aging band] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Work on hand
		lineageTag: eb1ad0ad-4c47-47f2-9284-47d6b00778db

	measure 'Received yesterday' = COALESCE ( CALCULATE ( COUNTROWS ( OpenTasks ), OpenTasks[Received yesterday] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Work on hand
		lineageTag: b99fac93-577b-4917-9a08-1e4ac688995e

	/// Green <= 15% out of service, Amber <= 30%, otherwise Red (thresholds to be confirmed by the business).
	measure 'Service status' = VAR p = [Out of service %] RETURN IF ( ISBLANK ( p ), BLANK (), IF ( p <= 0.15, "Green", IF ( p <= 0.30, "Amber", "Red" ) ) )
		displayFolder: Status
		lineageTag: 09cc8424-c945-4e82-829f-a654f58265c4

	measure 'Service status colour' = SWITCH ( [Service status], "Green", "#3EBD5E", "Amber", "#F3B921", "Red", "#D02D4F", "#8A949C" )
		displayFolder: Status
		lineageTag: 8750026d-a669-4cf7-a0b9-3fca25f7cfc8

	measure 'Service status icon' = SWITCH ( [Service status], "Green", UNICHAR ( 9679 ) & " Green", "Amber", UNICHAR ( 9679 ) & " Amber", "Red", UNICHAR ( 9679 ) & " Red", BLANK () )
		displayFolder: Status
		lineageTag: 6c3a3c3a-f2f9-46b9-988e-441fc91fecd2

	measure 'Work on hand subtitle' = FORMAT ( [Files on hand], "#,0" ) & " files  ·  oldest " & FORMAT ( [Oldest item (days)], "0" ) & " d  ·  " & FORMAT ( [Over 30 days], "#,0" ) & " over 30 d"
		displayFolder: Status
		lineageTag: ab6c8011-674f-4022-9ed0-5ecf9edbbd71

	measure 'Out of service subtitle' = FORMAT ( [Out of service], "#,0" ) & " of " & FORMAT ( [Work on hand], "#,0" ) & " available items past service level"
		displayFolder: Status
		lineageTag: c9857bbc-2200-428b-9bbb-4a602f692b22

	/// Out of service share of the whole team, ignoring the individual selected.
	measure 'Team out of service %' = CALCULATE ( [Out of service %], REMOVEFILTERS ( 'Dim Person' ), REMOVEFILTERS ( OpenTasks[Assigned to] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Status
		lineageTag: 24aa6131-8ae5-438e-afb1-3a806079f00f

	measure 'Sub: files' = FORMAT ( [Files on hand], "#,0" ) & " files"
		displayFolder: Subtitles
		lineageTag: 77e7f0df-4b1a-41b0-aa87-5fe42c5b9471

	measure 'Sub: files and scheduled' = FORMAT ( [Files on hand], "#,0" ) & " files  ·  " & FORMAT ( [Scheduled (not yet available)], "#,0" ) & " scheduled (not yet available)"
		displayFolder: Subtitles
		lineageTag: 5fba2b55-039b-487a-884d-d6c58447b271

	measure 'Sub: out of service items' = FORMAT ( [Out of service], "#,0" ) & " items"
		displayFolder: Subtitles
		lineageTag: 2ed2c897-ea2e-4c33-b58c-c84ff50d4cba

	measure 'Sub: out of service vs team' = FORMAT ( [Out of service], "#,0" ) & " items  ·  team " & FORMAT ( [Team out of service %], "0%" )
		displayFolder: Subtitles
		lineageTag: 860b321a-3e93-4398-8ceb-cf7187586996

	measure 'Sub: over 90' = FORMAT ( [Over 90 days %], "0%" ) & " of work on hand  ·  " & FORMAT ( [Over 30 days], "#,0" ) & " over 30"
		displayFolder: Subtitles
		lineageTag: d021dc1b-51b1-40c0-bac0-0e83692bd8da

	measure 'Sub: unassigned' = "oldest " & FORMAT ( [Unassigned oldest (days)], "0" ) & " d  ·  " & FORMAT ( [Unassigned over 30 days], "#,0" ) & " over 30"
		displayFolder: Subtitles
		lineageTag: 8630a5af-a11b-4c8c-babb-d361c813eefc

	measure 'Sub: unassigned files' = FORMAT ( [Unassigned files], "#,0" ) & " files"
		displayFolder: Subtitles
		lineageTag: 31b07e01-2009-493e-9531-82695b8853a9

	measure 'Sub: unassigned oldest' = "oldest " & FORMAT ( [Unassigned oldest (days)], "0" ) & " d"
		displayFolder: Subtitles
		lineageTag: 3ad730eb-7bd8-410a-a01a-2aa697b81620

	measure 'Sub: unassigned out of service' = FORMAT ( [Unassigned out of service], "#,0" ) & " items"
		displayFolder: Subtitles
		lineageTag: af582074-e24a-4635-8d8e-647fadd62cce

	measure 'Sub: band share' = FORMAT ( [Share of work on hand], "0%" ) & " of on hand"
		displayFolder: Subtitles
		lineageTag: 3a9315e5-f9da-44f6-81b4-8e8f9c86805a

	measure 'Sub: completed tasks' = FORMAT ( [Completed yesterday], "#,0" ) & " tasks  ·  release = completed"
		displayFolder: Subtitles
		lineageTag: d0ef14ca-5411-47a0-b914-18a70075a12e

	measure 'Context: tasks and files' = FORMAT ( [Work on hand], "#,0" ) & " tasks  ·  " & FORMAT ( [Files on hand], "#,0" ) & " files"
		displayFolder: Subtitles
		lineageTag: 0d5166e4-0ce6-4597-9669-5c0050fb1533

	measure 'Context: out of service' = FORMAT ( [Out of service], "#,0" ) & " out of service  ·  " & FORMAT ( [Out of service %], "0%" )
		displayFolder: Subtitles
		lineageTag: 3ef6cb19-e3d2-4eb6-8292-e4736344fc11

	measure 'Context: oldest' = "oldest " & FORMAT ( [Oldest item (days)], "0" ) & " d"
		displayFolder: Subtitles
		lineageTag: d62293dc-9e64-462c-977e-311aee4ad335

	measure 'Context: age mix' = VAR b = ADDCOLUMNS ( SUMMARIZE ( 'Dim Aging Band', 'Dim Aging Band'[Band label], 'Dim Aging Band'[Band order] ), "@n", [Work on hand] ) RETURN CONCATENATEX ( FILTER ( b, [@n] > 0 ), 'Dim Aging Band'[Band label] & " " & FORMAT ( [@n], "#,0" ), "  ·  ", 'Dim Aging Band'[Band order], ASC )
		displayFolder: Subtitles
		lineageTag: e45f46d1-1dca-449d-9def-7fa40085e992

	measure 'Unassigned items' = COALESCE ( CALCULATE ( [Work on hand], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: 2b9be096-8314-4633-bcab-a59574934a6c

	measure 'Unassigned files' = CALCULATE ( [Files on hand], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: aa6e7da6-fd4e-4608-ba49-d3bce71e282c

	measure 'Unassigned over 30 days' = COALESCE ( CALCULATE ( [Over 30 days], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: 914d94b1-0ac8-4114-97d7-8141c36d7b69

	measure 'Unassigned out of service' = COALESCE ( CALCULATE ( [Out of service], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Unassigned
		lineageTag: 0771530e-8db8-406b-aef9-f2325fbe577e

	measure 'Unassigned out of service %' = DIVIDE ( [Unassigned out of service], [Unassigned items] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Unassigned
		lineageTag: 182973d1-7dba-4b0c-bf44-fbe966c579e4

	measure 'Unassigned oldest (days)' = CALCULATE ( [Oldest item (days)], REMOVEFILTERS ( 'Dim Person' ), OpenTasks[Is unassigned] = TRUE () )
		formatString: 0
		displayFolder: Unassigned
		lineageTag: d04e948f-c74d-4a4b-ad59-c85ab422208d

	measure 'Renewals in pipeline' = CALCULATE ( [Work on hand], OpenTasks[In renewal pipeline] = TRUE () )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: 4029ce87-ef62-4a7d-a4d0-7619ba53aa7d

	measure 'Share of renewals' = DIVIDE ( [Renewals in pipeline], CALCULATE ( [Renewals in pipeline], REMOVEFILTERS ( OpenTasks[Renewal stage] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Renewal pipeline
		lineageTag: 75eaebe7-2aa9-4334-aaf9-1fb63f3112bc

	measure 'Not yet quoted' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Not yet quoted" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: dc8b3d37-73bb-4778-97c1-792fa4621d53

	measure 'Quoted - with agent' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Quoted - with agent" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: 292032f3-8be3-4365-ae77-79e4cab4b8fc

	measure 'Bound - awaiting issue' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Bound - awaiting issue" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: bbce416b-f628-449b-8fb9-7c80fb32c6c0

	measure 'Not renewing' = CALCULATE ( [Renewals in pipeline], OpenTasks[Renewal stage] = "Not renewing" )
		formatString: #,0
		displayFolder: Renewal pipeline
		lineageTag: 20534cff-2d3e-411d-9d51-a4c8e4ee5ee5

	measure 'Not quoted %' = DIVIDE ( [Not yet quoted], [Renewals in pipeline] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Renewal pipeline
		lineageTag: 1c1212b9-d6ce-42be-9752-6d337123d5d5

	measure 'Renewal stage subtitle' = FORMAT ( [Share of renewals], "0%" ) & " of renewals  |  " & FORMAT ( [Out of service], "#,0" ) & " out of service  |  oldest " & FORMAT ( [Oldest item (days)], "0" ) & " d"
		displayFolder: Renewal pipeline
		lineageTag: 41584a7c-e3d2-4d61-b1f7-1e749047df28

	/// Release/Kill actions on the day before the snapshot. Release = completed.
	measure 'Completed yesterday' = COALESCE ( COUNTROWS ( Completed ), 0 )
		formatString: #,0
		displayFolder: Completed
		lineageTag: af2861d1-fb99-4a47-8926-642f076881c2

	measure 'Met SLA on completion' = CALCULATE ( COUNTROWS ( Completed ), Completed[Met SLA] = TRUE () )
		formatString: #,0
		displayFolder: Completed
		lineageTag: 12dccfe5-9954-4319-bf3f-c00363d559b7

	measure 'Within SLA on completion %' = DIVIDE ( [Met SLA on completion], [Completed yesterday] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Completed
		lineageTag: 3f3b7bce-ce8c-4189-ab01-3fb038335d12

	measure 'Median turnaround (days)' = MEDIAN ( Completed[Turnaround (days)] )
		formatString: 0.0
		displayFolder: Completed
		lineageTag: a57ff684-e664-4de5-8a11-aed1af48ca3f

	measure 'Average turnaround (days)' = AVERAGE ( Completed[Turnaround (days)] )
		formatString: 0.0
		displayFolder: Completed
		lineageTag: bf4eca89-6a21-4f59-9de8-59e34889c577

	measure 'Median hours in step' = MEDIAN ( Completed[Hours in step] )
		formatString: 0.0
		displayFolder: Completed
		lineageTag: 9095d338-0833-40b0-8378-48d933977ee8

	measure 'Median time in step' = VAR h = [Median hours in step] RETURN IF ( ISBLANK ( h ), BLANK (), IF ( h < 24, FORMAT ( h, "0.0" ) & " h", FORMAT ( h / 24, "0.0" ) & " d" ) )
		displayFolder: Completed
		lineageTag: 32a99062-7631-416d-9e0a-1077a7c3bd78

	measure 'Rework released' = COALESCE ( CALCULATE ( COUNTROWS ( Completed ), Completed[Is rework] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Completed
		lineageTag: 45cbc6c6-d54a-43ca-b9f2-51e251866298

	measure 'Production released' = [Completed yesterday] - [Rework released]
		formatString: #,0
		displayFolder: Completed
		lineageTag: 61f587fe-86d9-49aa-9804-0863e4b5c256

	measure 'Rework rate' = DIVIDE ( [Rework released], [Completed yesterday] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Completed
		lineageTag: f9e67bf8-e833-43ee-ace5-8d2849ef8b6f

	measure 'Within hour target' = SUMX ( Completed, IF ( Completed[Hours in step] <= RELATED ( 'Dim Step'[Hour target] ), 1, 0 ) )
		formatString: #,0
		displayFolder: Completed
		lineageTag: 57ce67ab-0da5-42ac-91b1-56f871766bb7

	measure 'Within hour target %' = DIVIDE ( [Within hour target], [Completed yesterday] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Completed
		lineageTag: 85d0eb3f-7162-4a69-9fa9-273602c1f715

	measure 'Open filings' = COUNTROWS ( Compliance )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: e5905d74-5625-4414-ab8e-103620f35bd0

	measure 'Past due' = COALESCE ( CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "past" ), 0 )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: a02c9a99-0e8f-40a9-8059-946de0080b09

	measure 'Past due - fining states' = COALESCE ( CALCULATE ( [Past due], Compliance[Fining state] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 6a43d6a4-b994-4902-9506-736cbd01642a

	measure 'Past due and over 30 days (stuck)' = CALCULATE ( [Past due], Compliance[Over 30 days] = TRUE () )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 185aca81-d833-45e3-8a0a-2a4f98564b4a

	measure 'Due within 14 days' = COALESCE ( CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "red" ), 0 )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 3c27dd6c-171e-40d8-823a-3090bb301a01

	measure 'Due in 15-30 days' = COALESCE ( CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "amber" ), 0 )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: a5f6ccab-a4d8-47e6-a8c4-0c6d0426ec34

	measure 'On track' = COALESCE ( CALCULATE ( COUNTROWS ( Compliance ), Compliance[Due band code] = "green" ), 0 )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 1c2cf79b-f4d9-4f25-b626-550ab93dd93d

	measure 'Filings over 30 days old' = CALCULATE ( COUNTROWS ( Compliance ), Compliance[Over 30 days] = TRUE () )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: d44ca9ca-132b-4625-ac57-5ef95c62b431

	measure 'Oldest past due (days)' = CALCULATE ( MAX ( Compliance[Days past due] ), Compliance[Due band code] = "past" )
		formatString: +0;-0;0
		displayFolder: Compliance
		lineageTag: c4f8a99e-7101-469e-9fc0-e35166ea02ac

	measure 'Compliance status' = IF ( [Past due] > 0, "Past due", IF ( [Due within 14 days] > 0, "Due within 14 days", "On track" ) )
		displayFolder: Compliance
		lineageTag: 26e2f8b9-ba30-4a11-8d74-0fa5287c6aca

	measure 'Fining state flag' = IF ( CALCULATE ( COUNTROWS ( Compliance ), Compliance[Fining state] = TRUE () ) > 0, "FINES", "" )
		displayFolder: Compliance
		lineageTag: df357f61-62b1-4970-a427-64401a82eb58

	measure 'Filings in processing' = COALESCE ( CALCULATE ( COUNTROWS ( Compliance ), Compliance[State] = "Processing" ), 0 )
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 0bcd65bb-5706-4792-aa44-c36bf39fc437

	measure 'Sub: past due stuck' = FORMAT ( [Past due and over 30 days (stuck)], "#,0" ) & " of them also over 30 days old  —  stuck"
		displayFolder: Subtitles
		lineageTag: 17708b2a-a8d6-4161-b579-bd98a8311ab2

	measure 'Sub: open filings' = FORMAT ( [Filings over 30 days old], "#,0" ) & " over 30 days old" & IF ( [Filings in processing] > 0, "  ·  " & FORMAT ( [Filings in processing], "#,0" ) & " in processing", "" )
		displayFolder: Subtitles
		lineageTag: 55c847c9-465f-4b41-bb60-cebeb9244118

	column 'Measure key'
		dataType: int64
		isHidden
		lineageTag: c8253669-bac8-4669-9c6f-2c6054bb2b82
		summarizeBy: none
		sourceColumn: Measure key

		annotation SummarizationSetBy = User

	partition '_Measures' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Measure key" = Int64.Type], {{1}})
				in
				    Source

	annotation PBI_ResultType = Table
