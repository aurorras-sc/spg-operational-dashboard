expression SPG_Workbook =
		let
		    Binary = if Text.StartsWith(Text.Lower(DataPath), "http") then Web.Contents(DataPath) else File.Contents(DataPath),
		    Source = Excel.Workbook(Binary, null, true)
		in
		    Source
