model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataPath", "SnapshotDate", "SLA_Cap_Days", "Fining_States", "Green_Max_OutOfService", "Amber_Max_OutOfService", "SPG_Workbook", "OpenTasks", "Completed", "Compliance", "Dim Team", "Dim Workflow", "Dim Step", "Dim Person", "Dim Aging Band", "Thresholds", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.138.1452.0 (25.02)

ref table 'OpenTasks'
ref table 'Completed'
ref table 'Compliance'
ref table 'Dim Team'
ref table 'Dim Workflow'
ref table 'Dim Step'
ref table 'Dim Person'
ref table 'Dim Aging Band'
ref table 'Thresholds'
ref table '_Measures'

ref cultureInfo en-US
